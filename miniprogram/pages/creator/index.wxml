<view class="page"><view wx:if="error" class="error">{{error}}</view><block wx:if="creator"><view class="hero"><view class="eyebrow">CREATOR PORTRAIT</view><view class="row"><view class="avatar">{{creator.initial}}</view><view class="title">{{creator.nickname}}</view></view><view class="tag spaced">{{creator.genre}}</view><view class="muted pre">{{creator.bio}}</view></view><view class="section-title">代表作品</view><view wx:for="{{creator.works}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="work"><view class="row between"><view class="work-title">{{item.title}}</view><text class="score">{{item.total}}</text></view><view class="excerpt">{{item.text}}</view></view><view wx:if="!creator.works.length" class="empty">作品正在打磨，期待第一声。</view><view class="section-title">听见彼此</view><view wx:for="{{creator.comments}}" wx:key="id" class="card"><view class="row between"><text>{{item.authorName}}</text><text class="muted">{{item.date}}</text></view><view class="pre spaced">{{item.text}}</view><button class="ghost" data-id="{{item.id}}" bindtap="report">举报</button></view><block wx:if="session.features.comments"><textarea value="{{text}}" maxlength="500" bindinput="field" placeholder="留下具体、友善的创作建议。"/><button class="primary spaced" bindtap="comment" loading="{{busy}}" disabled="{{busy}}">提交评论，审核后展示</button></block><view wx:else class="notice">评论功能暂未开放。</view><button class="ghost spaced" bindtap="report">举报该主页</button></block></view>
