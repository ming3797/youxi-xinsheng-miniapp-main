<view class="page"><view class="eyebrow">{{session.user.role === 'admin' ? 'OPERATIONS DESK' : 'EXPERT REVIEW'}}</view><view class="title">{{session.user.role === 'admin' ? '把下一步安排好。' : '让专业，给予方向。'}}</view><view wx:if="error" class="error spaced">{{error}}</view><view wx:if="isDemo" class="demo spaced">示例角色与数据，仅供开发验收。</view>
  <view class="section-title">{{session.user.role === 'admin' ? '投稿与评审管理' : '分配给我的作品'}}</view><view wx:for="{{works}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row between"><text class="tag tag-green">{{item.statusText}}</text><text class="muted">{{item.reviews.length}}份评审</text></view><view class="work-title">{{item.title}}</view><view class="muted">{{item.authorName}} · {{item.genre}} →</view></view><view wx:if="!works.length" class="empty">暂时没有待处理作品。</view>
  <block wx:if="session.user.role === 'admin'"><view class="section-title">创作者与专家</view><view wx:for="{{users}}" wx:key="id" class="card"><view class="row between"><text style="font-weight:600">{{item.nickname}}</text><text class="tag">{{item.role === 'expert' ? '专家' : item.role === 'admin' ? '运营' : '创作者'}}</text></view><view class="muted spaced">{{item.bio}}</view><view class="muted">{{item.profileConsent ? '已授权个人主页展示' : '尚未授权公开主页'}}</view><view class="actions"><button wx:if="item.role === 'creator'" class="secondary" data-id="{{item.id}}" bindtap="grant" disabled="{{busy}}">核验并开通专家</button><button wx:if="session.features.showcase && item.profileConsent" class="secondary" data-id="{{item.id}}" data-published="{{item.profilePublished}}" bindtap="publishProfile" disabled="{{busy}}">{{item.profilePublished ? '下架主页' : '审核并展示主页'}}</button></view><button wx:if="session.features.showcase && item.profilePublished" class="ghost spaced" data-id="{{item.id}}" data-published="{{false}}" bindtap="publishProfile">按当前资料更新主页</button></view>
  <view class="section-title">评论待审 · {{comments.length}}</view><view wx:for="{{comments}}" wx:key="id" class="card"><view class="muted">{{item.authorName}}</view><view class="pre spaced">{{item.text}}</view><view class="actions"><button class="secondary jade" data-id="{{item.id}}" data-status="approved" bindtap="moderate" disabled="{{busy}}">通过并展示</button><button class="secondary" data-id="{{item.id}}" data-status="rejected" bindtap="moderate" disabled="{{busy}}">不予展示</button></view></view>
  <view class="section-title">举报待处理 · {{reports.length}}</view><view wx:for="{{reports}}" wx:key="id" class="card"><view class="pre">{{item.reason}}</view><view class="muted spaced">目标记录：{{item.targetId}}</view><view class="actions"><button class="secondary" data-id="{{item.id}}" data-resolution="remove" bindtap="resolve" disabled="{{busy}}">下架并结案</button><button class="secondary" data-id="{{item.id}}" data-resolution="dismiss" bindtap="resolve" disabled="{{busy}}">保留并结案</button></view></view>
  </block>
</view>
