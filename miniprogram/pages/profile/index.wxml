<view class="page"><view class="eyebrow">MY VOICE, MY STAGE</view><view class="title">每一步，都有回声。</view><view wx:if="isDemo" class="demo spaced"><view>开发体验身份（仅本地模式提供）</view><picker range="{{actors}}" range-key="label" value="{{actorIndex}}" bindchange="actor"><view style="font-size:28rpx;margin-top:12rpx">{{actors[actorIndex].label}}　⌄</view></picker></view><view wx:if="error" class="error">{{error}}</view>
  <view class="stat-grid"><view class="stat"><view class="stat-value">{{session.user.points || 0}}</view><view class="small">可用积分</view></view><view class="stat"><view class="stat-value">{{dashboard.works.length || 0}}</view><view class="small">我的投稿</view></view><view class="stat"><view class="stat-value">{{passedCount}}</view><view class="small">评审通过</view></view></view>
  <button wx:if="session.user.role === 'admin' || session.user.role === 'expert'" class="primary" bindtap="desk">{{session.user.role === 'admin' ? '进入运营工作台' : '进入专家评审席'}}</button>
  <view class="section-title">个人IP资料</view><view class="card"><view class="field"><text class="label">昵称 / 创作署名</text><input value="{{form.nickname}}" data-key="nickname" bindinput="field" maxlength="20"/></view><view class="field"><text class="label">主要剧种</text><picker range="{{genres}}" value="{{genreIndex}}" bindchange="genre"><view class="select">{{form.genre}} ⌄</view></picker></view><view class="field"><text class="label">我的创作介绍</text><textarea value="{{form.bio}}" data-key="bio" bindinput="field" maxlength="300"/></view><checkbox-group bindchange="consent"><label class="check"><checkbox value="yes" checked="{{form.profileConsent}}" color="#a72d33"/><text>允许运营审核后公开展示我的昵称、介绍与主要剧种。取消后保存将立即下架个人主页。</text></label></checkbox-group><button class="secondary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存个人资料</button><view class="form-note">资料修改后需运营重新审核才能更新公开主页。</view><button wx:if="session.user.profilePublished" class="ghost" bindtap="publicPage">查看已公开主页 →</button></view>
  <view class="section-title">积分流水</view><view class="card"><view wx:for="{{ledger}}" wx:key="id" class="row between link-row"><view class="grow"><view>{{item.reason}}</view><view class="muted">{{item.date}} · 余额{{item.balance}}</view></view><text style="font-size:32rpx;color:#1f5b50">{{item.deltaText}}</text></view></view>
  <button class="ghost" bindtap="copyId">复制我的账号编号（用于开通专家或运营）</button><button class="ghost spaced" bindtap="policy">投稿规则与隐私说明</button>
</view>
