<view class="page"><view wx:if="error" class="error">{{error}}</view><block wx:if="work">
  <view class="row between"><text class="tag tag-green">{{work.statusText}}</text><text class="muted">{{work.date}}</text></view><view class="title spaced">{{work.title}}</view><view class="muted spaced">{{work.authorName}} · {{work.genre}} · {{work.typeText}}</view>
  <view class="card spaced"><view class="pre excerpt">{{work.text}}</view><view class="divider"></view><text class="small muted">{{work.aiUse === 'none' ? '作者声明未使用AI' : '本作品包含AI辅助创作内容'}}</text></view>
  <view wx:for="{{work.files}}" wx:key="fileId" class="link-row row between" data-index="{{index}}" bindtap="file"><text class="grow">附件 · {{item.name}}</text><text class="small">打开 ↗</text></view>
  <view wx:if="work.rejectionReason" class="notice">未受理原因：{{work.rejectionReason}}</view>
  <view class="section-title">专业评审</view><view class="card"><view wx:if="work.total !== null" class="row between"><view><view class="muted">专业综合评分</view><text class="small">与人气、积分和付费无关</text></view><text class="score">{{work.total}}</text></view><view wx:else class="muted">评审完成后显示结论。专家独立打分，提交前无法查看其他人的评分。</view><view wx:for="{{work.dimensions}}" wx:key="key" class="row between link-row"><text>{{item.label}}</text><text>{{item.value}}</text></view><view wx:for="{{work.reviews}}" wx:key="expertId" class="spaced"><text class="tag">{{item.name}} · {{item.total}}分</text><view class="pre muted spaced">{{item.comment}}</view></view></view>
  <view wx:if="work.benefits.length" class="section-title">我的成长权益</view><view wx:for="{{work.benefits}}" wx:key="name" class="card"><view>{{item.name}}</view><view class="muted spaced">{{item.status}}</view></view>
  <view wx:if="canAssign" class="card"><view class="section-title" style="margin-top:0">分配独立专家</view><view class="form-note">初评选择2位；需要复核时保留原2位并增加第3位。</view><checkbox-group bindchange="pickExperts"><label wx:for="{{experts}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#a72d33"/><text>{{item.nickname}} · {{item.genre}}</text></label></checkbox-group><button class="primary" bindtap="assign" loading="{{busy}}" disabled="{{busy}}">确认分配</button></view>
  <view wx:if="canReview" class="card"><view class="section-title" style="margin-top:0">提交专业意见</view><view wx:for="{{scores}}" wx:key="key"><view class="row between"><text>{{item.label}}</text><text>{{item.value}}分</text></view><slider min="0" max="100" value="{{item.value}}" activeColor="#1f5b50" data-index="{{index}}" bindchange="score"/></view><textarea value="{{comment}}" data-key="comment" bindinput="field" maxlength="2400" placeholder="请给出至少20字、有具体修改方向的意见。"/><checkbox-group bindchange="conflict"><label class="check"><checkbox value="yes" checked="{{noConflict}}" color="#a72d33"/><text>我与作者无利益冲突，已独立审阅本次冻结版本。</text></label></checkbox-group><button class="primary" bindtap="review" loading="{{busy}}" disabled="{{busy}}">提交并冻结本次评审</button></view>
  <view wx:if="canIncubate" class="card"><view class="section-title" style="margin-top:0">确认入选孵化</view><input value="{{schedule}}" data-key="schedule" bindinput="field" placeholder="填写真实培训时间与联系安排" maxlength="300"/><button class="secondary spaced" bindtap="incubate" disabled="{{busy}}">确认安排并发放奖励</button></view>
  <view wx:if="admin && work.status === 'submitted'" class="card"><input value="{{rejectionReason}}" data-key="rejectionReason" bindinput="field" placeholder="不受理时请填写原因，至少5字"/><button class="secondary spaced" bindtap="reject" disabled="{{busy}}">退回补充</button></view>
  <button wx:if="canPublish" class="secondary spaced" bindtap="publish" disabled="{{busy}}">{{work.published ? '下架公开正文' : '审核通过，公开作品正文'}}</button>
  <button wx:if="mine && work.allowDisplay" class="ghost spaced" bindtap="revoke" disabled="{{busy}}">撤回作品展示授权</button>
  <button wx:if="work.published" class="ghost spaced" bindtap="report" disabled="{{busy}}">举报这份公开内容</button>
</block></view>
